# Discord bot credentials and target guild (Discord snowflake)
# Find DISCORD_GUILD_ID in Discord: Server Settings -> Widget -> Server ID
# or enable Developer Mode and right-click the server -> Copy Server ID.
DISCORD_BOT_TOKEN=CHANGE_ME_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=CHANGE_ME_DISCORD_GUILD_ID
STEAM_API_KEY=CHANGE_ME_STEAM_API_KEY

# Frontend API guild query value.
# Current dashboard expects the internal DB guild id (usually 1 on first install).
# Determine it with:
# docker compose exec postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "select id, discord_guild_id, name from guilds;"
VITE_GUILD_ID=CHANGE_ME_INTERNAL_GUILD_ID

POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=CHANGE_ME_POSTGRES_DB
# IMPORTANT: Update DATABASE_URL to match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
DATABASE_URL=postgresql+psycopg://CHANGE_ME_POSTGRES_USER:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/CHANGE_ME_POSTGRES_DB

TIMEZONE=Europe/London
WEB_PORT=8080
DOCKERHUB_NAMESPACE=id0ntplaygam3s
APP_IMAGE_TAG=latest

ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

SESSION_RETENTION_DAYS=
RETENTION_CHECK_INTERVAL_MINUTES=60
CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO
APP_VERSION=1.0.0
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=720
